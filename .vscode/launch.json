{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "PolySheet: Rust (Tauri)",
            "cargo": {
                "args": [
                    "build",
                    "--manifest-path=${workspaceFolder}/polysheet/src-tauri/Cargo.toml",
                    "--no-default-features"
                ],
                "filter": {
                    "name": "polysheet-app",
                    "kind": "bin"
                }
            },
            "cwd": "${workspaceFolder}/polysheet",
            "preLaunchTask": "PolySheet: Vite dev server",
            "env": {
                "WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS": "--remote-debugging-port=9222"
            },
            "sourceLanguages": [
                "rust"
            ]
        },
        {
            "type": "pwa-msedge",
            "request": "attach",
            "name": "PolySheet: Svelte (WebView2)",
            "address": "127.0.0.1",
            "port": 9222,
            "urlFilter": "http://localhost:1421/*",
            "webRoot": "${workspaceFolder}/polysheet",
            "sourceMaps": true,
            "timeout": 120000,
            "preLaunchTask": "PolySheet: Wait for WebView2 debugger",
            "skipFiles": [
                "<node_internals>/**",
                "${workspaceFolder}/polysheet/node_modules/**"
            ]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'PolyGen'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=polygen",
                    "--package=polygen"
                ],
                "filter": {
                    "name": "polygen",
                    "kind": "bin"
                }
            },
            "args": [
                "examples/game_schema.poly"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'PolyGen'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=polygen",
                    "--package=polygen"
                ],
                "filter": {
                    "name": "polygen",
                    "kind": "bin"
                }
            },
            "args": [
                "examples/game_schema.poly"
            ],
            "cwd": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "PolySheet: Full Stack",
            "configurations": [
                "PolySheet: Rust (Tauri)",
                "PolySheet: Svelte (WebView2)"
            ],
            "stopAll": true
        }
    ]
}
