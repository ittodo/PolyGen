%logic
// Unreal editor-only source-backed mutable row references.
// CSV/JSON files remain the source of truth; Binary/registry outputs are caches.

import "templates/unreal/rhai_utils/type_mapping" as ue_types;

fn to_pascal(name) {
    let parts = name.split("_");
    let result = "";
    for part in parts {
        if part.len() > 0 {
            let first = part.sub_string(0, 1);
            first = first.to_upper();
            let rest = part.sub_string(1);
            result += first + rest;
        }
    }
    result
}

fn fields_of(s) {
    let result = [];
    for item in s.items {
        if item.is_field() {
            result.push(item.as_field());
        }
    }
    result
}

fn pk_field_of(s) {
    for field in fields_of(s) {
        if field.is_primary_key {
            return field;
        }
    }
    return ();
}

fn load_paths_for_struct(s) {
    let csv_path = "";
    let json_path = "";
    if s.load != () {
        if s.load.csv != () {
            csv_path = s.load.csv;
        }
        if s.load.json != () {
            json_path = s.load.json;
        }
    }
    #{ csv_path: csv_path, json_path: json_path }
}

fn source_entries_from_namespace(ns, include_file, loaders_file) {
    let result = [];
    for item in ns.items {
        if item.is_struct() {
            let s = item.as_struct();
            let pk = pk_field_of(s);
            let paths = load_paths_for_struct(s);
            if paths.csv_path != "" || paths.json_path != "" {
                let has_primary_key = pk != ();
                let key_type = "int32";
                let pk_pascal = "SourceRefId";
                if has_primary_key {
                    key_type = ue_types::map_type_with_ns(pk.field_type, "");
                    pk_pascal = to_pascal(pk.name);
                }
                let field_entries = [];
                for field in fields_of(s) {
                    field_entries.push(#{
                        def: field,
                        type_name: ue_types::map_type_with_ns(field.field_type, ""),
                        pascal_name: to_pascal(field.name)
                    });
                }
                result.push(#{
                    def: s,
                    pk: pk,
                    has_primary_key: has_primary_key,
                    fields: field_entries,
                    struct_name: ue_types::get_struct_name(s.name),
                    ref_name: "FPolygen" + s.name + "SourceRef",
                    key_type: key_type,
                    pk_pascal: pk_pascal,
                    csv_path: paths.csv_path,
                    json_path: paths.json_path,
                    include_file: include_file,
                    loaders_file: loaders_file
                });
            }
        } else if item.is_namespace() {
            let nested = source_entries_from_namespace(item.as_namespace(), include_file, loaders_file);
            for entry in nested {
                result.push(entry);
            }
        }
    }
    result
}

let entries = [];
for schema_file in schema.files {
    let poly_path = schema_file.path + "";
    let stem = poly_path;
    if stem.contains("/") {
        let parts = stem.split("/");
        stem = parts[parts.len - 1];
    }
    if stem.contains("\\") {
        let parts = stem.split("\\");
        stem = parts[parts.len - 1];
    }
    if stem.ends_with(".poly") {
        stem = stem.sub_string(0, stem.len() - 5);
    }
    let include_file = "Polygen" + to_pascal(stem) + ".h";
    let loaders_file = "Polygen" + to_pascal(stem) + "Loaders.h";

    for ns in schema_file.namespaces {
        let namespace_entries = source_entries_from_namespace(ns, include_file, loaders_file);
        for entry in namespace_entries {
            entries.push(entry);
        }
    }
}

let include_headers = [];
let seen_headers = [];
for entry in entries {
    if !seen_headers.contains(entry.include_file) {
        include_headers.push(entry.include_file);
        seen_headers.push(entry.include_file);
    }
    if !seen_headers.contains(entry.loaders_file) {
        include_headers.push(entry.loaders_file);
        seen_headers.push(entry.loaders_file);
    }
}

let has_entries = entries.len() > 0;
%endlogic
