template <typename RowType>
static bool PolygenSourceRefsSaveJsonArray(const FString& JsonPath, const TArray<RowType>& Rows)
{
    FString JsonContent = TEXT("[");
    for (int32 RowIndex = 0; RowIndex < Rows.Num(); ++RowIndex)
    {
        FString RowJson;
        if (!FJsonObjectConverter::UStructToJsonObjectString(Rows[RowIndex], RowJson))
        {
            return false;
        }
        if (RowIndex > 0)
        {
            JsonContent += TEXT(",");
        }
        JsonContent += LINE_TERMINATOR;
        JsonContent += RowJson;
    }
    if (Rows.Num() > 0)
    {
        JsonContent += LINE_TERMINATOR;
    }
    JsonContent += TEXT("]");
    return FFileHelper::SaveStringToFile(JsonContent, *JsonPath);
}
%blank
static bool PolygenSourceRefsEnsureDirectory(const FString& SourcePath)
{
    const FString Directory = FPaths::GetPath(SourcePath);
    return Directory.IsEmpty() || IFileManager::Get().MakeDirectory(*Directory, true);
}
