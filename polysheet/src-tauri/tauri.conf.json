{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PolySheet",
  "version": "0.1.17",
  "identifier": "dev.polygen.polysheet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PolySheet",
        "width": 1500,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["../../gui/src-tauri/icons/icon.ico"]
  }
}
