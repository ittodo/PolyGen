// Test Case 07: Indexes
// Tests primary_key, unique, and foreign_key constraints

namespace test.indexes {
    enum CategoryKind {
        Public = 1;
        Internal = 2;
    }

    /// User table with primary key and unique constraint
    @index(display_name, id, unique: true, as: display_identity)
    @index(display_name, as: by_display_name)
    table User {
        id: u32 primary_key;
        username: string unique;
        email: string unique;
        display_name: string;
    }

    /// Category with simple primary key
table Category {
    id: u32 primary_key;
    @search(mode: exact)
    name: string unique;
    @search
    description: string?;
        @search
        rank: u8;
        @search
        kind: CategoryKind;
    }

    /// Post with foreign keys
    table Post {
        id: u32 primary_key;
        @search(name: title_search)
        title: string;
        content: string;
        author_id: u32 foreign_key(User.id);
        category_id: u32 foreign_key(Category.id);
    }

    /// Table-level refs to named indexes.
    @ref(name: user, target: User.display_identity, fields: (display_name, user_id))
    @ref(name: display_matches, target: User.by_display_name, fields: (display_query))
    table UserLookup {
        id: u32 primary_key;
        display_name: string;
        display_query: string;
        user_id: u32;
    }

    /// Table-level ref to a named search index.
    @ref(name: title_matches, target: Post.title_search, fields: (query))
    table PostSearch {
        id: u32 primary_key;
        query: string;
    }

    /// Comment with multiple foreign keys
    table Comment {
        id: u32 primary_key;
        post_id: u32 foreign_key(Post.id);
        author_id: u32 foreign_key(User.id);
        content: string;
        parent_id: u32?;  // optional self-reference
    }

    /// Tag for many-to-many relationship
    table Tag {
        id: u32 primary_key;
        name: string unique;
    }

    /// Junction table for Post-Tag relationship
    table PostTag {
        post_id: u32 foreign_key(Post.id);
        tag_id: u32 foreign_key(Tag.id);
    }
}
